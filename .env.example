# Postgres connection string used by the backend and by goose migrations.
DATABASE_URL=postgres://splitbill:splitbill@localhost:5432/splitbill?sslmode=disable

# HTTP port the backend listens on. Defaults to 8080 if unset.
PORT=8080

# Used by docker-compose.yml to configure the Postgres container.
POSTGRES_USER=splitbill
POSTGRES_PASSWORD=splitbill
POSTGRES_DB=splitbill
