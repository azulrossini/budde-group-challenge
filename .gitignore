# Env files (see .env.example for the documented template)
.env
.env.*
!.env.example

# Go
backend/server
backend/split-bill
backend/*.exe
backend/*.test
backend/*.out

# Embedded SPA build output (copied in during the Docker build; keep the placeholder)
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep

# OS
.DS_Store

# frontend/ has its own .gitignore (node_modules, dist, etc.)
